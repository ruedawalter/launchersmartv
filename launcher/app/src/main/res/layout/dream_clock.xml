<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <View
            android:layout_width="48dp"
            android:layout_height="2dp"
            android:background="#FF00D9FF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="LOCAL SYSTEM TIME"
            android:textColor="#FF00D9FF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.20" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:baselineAligned="true">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFEAFBFF"
                android:textSize="30sp"
                android:fontFamily="@font/orbitron_medium"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false"
                android:shadowColor="#8800D9FF"
                android:shadowRadius="16" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#FF00D9FF"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
            android:singleLine="true" />
        </LinearLayout>

        <TextClock
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginTop="8dp"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#B3D5E8F0"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.0"
            android:textAllCaps="true" />

    </LinearLayout>
</FrameLayout>
